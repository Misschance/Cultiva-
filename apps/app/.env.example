# Copie para .env e preencha com os dados do projeto Supabase (Project Settings > API).
# A chave "anon" é pública por definição; quem protege os dados é o RLS no banco.
# Nunca coloque aqui a chave service_role (SEG-7).
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
